import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import FactorAnalysis

# Load dataset
data = load_iris()
X = data.data

# Standardize data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Apply Factor Analysis
fa = FactorAnalysis(n_components=2, random_state=42)
X_factors = fa.fit_transform(X_scaled)

# Display factor values
df = pd.DataFrame(X_factors, columns=['Factor 1', 'Factor 2'])
print("Factor Analysis Results:")
print(df.head())

# Display factor loadings
loadings = pd.DataFrame(
    fa.components_.T,
    index=data.feature_names,
    columns=['Factor 1', 'Factor 2']
)
print("\nFactor Loadings:")
print(loadings)

# Visualization
plt.scatter(X_factors[:, 0], X_factors[:, 1], c=data.target)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Factor Analysis Visualization")
plt.colorbar(label="Iris Class")
plt.show()
