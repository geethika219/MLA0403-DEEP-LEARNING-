import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import convolve2d

# Generate sample image
np.random.seed(42)

image = np.random.rand(28, 28)

# Define convolution filters
filters = [
    np.array([[1, 0, -1],
              [1, 0, -1],
              [1, 0, -1]]),

    np.array([[1, 1, 1],
              [0, 0, 0],
              [-1, -1, -1]])
]

# Convolutional feature extraction
feature_maps = []

for kernel in filters:

    feature = convolve2d(
        image, kernel,
        mode='same',
        boundary='symm'
    )

    # Activation function
    feature = 1 / (1 + np.exp(-feature))

    feature_maps.append(feature)

# Reconstruction
reconstructed = np.mean(feature_maps, axis=0)

# Display results
plt.figure(figsize=(10, 4))

plt.subplot(1, 4, 1)
plt.imshow(image, cmap='gray')
plt.title("Input Image")
plt.axis('off')

plt.subplot(1, 4, 2)
plt.imshow(feature_maps[0], cmap='gray')
plt.title("Feature Map 1")
plt.axis('off')

plt.subplot(1, 4, 3)
plt.imshow(feature_maps[1], cmap='gray')
plt.title("Feature Map 2")
plt.axis('off')

plt.subplot(1, 4, 4)
plt.imshow(reconstructed, cmap='gray')
plt.title("Reconstruction")
plt.axis('off')

plt.tight_layout()
plt.show()

print("Convolutional Boltzmann-style Simulation Completed")
print("Input Shape:", image.shape)
print("Output Shape:", reconstructed.shape)
