import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf

from tensorflow.keras import layers, Model
from tensorflow.keras.datasets import mnist

# Load MNIST dataset
(x_train, _), (_, _) = mnist.load_data()

x_train = x_train.astype("float32") / 255.0
x_train = x_train.reshape(-1, 784)

# ---------------- VAE MODEL ----------------

latent_dim = 2

# Encoder
inputs = layers.Input(shape=(784,))
h = layers.Dense(256, activation='relu')(inputs)

z_mean = layers.Dense(latent_dim)(h)
z_log_var = layers.Dense(latent_dim)(h)

def sampling(args):
    mean, log_var = args
    epsilon = tf.random.normal(shape=tf.shape(mean))
    return mean + tf.exp(0.5 * log_var) * epsilon

z = layers.Lambda(sampling)([z_mean, z_log_var])

encoder = Model(inputs, [z_mean, z_log_var, z])

# Decoder
latent_inputs = layers.Input(shape=(latent_dim,))
h = layers.Dense(256, activation='relu')(latent_inputs)
outputs = layers.Dense(784, activation='sigmoid')(h)

decoder = Model(latent_inputs, outputs)

# VAE
class VAE(Model):
    def __init__(self, encoder, decoder):
        super().__init__()
        self.encoder = encoder
        self.decoder = decoder

    def train_step(self, data):
        with tf.GradientTape() as tape:
            mean, log_var, z = self.encoder(data)
            reconstruction = self.decoder(z)

            recon_loss = tf.reduce_mean(
                tf.reduce_sum(
                    tf.square(data - reconstruction), axis=1
                )
            )

            kl_loss = -0.5 * tf.reduce_mean(
                tf.reduce_sum(
                    1 + log_var - tf.square(mean)
                    - tf.exp(log_var), axis=1
                )
            )

            loss = recon_loss + kl_loss

        gradients = tape.gradient(
            loss, self.trainable_weights
        )

        self.optimizer.apply_gradients(
            zip(gradients, self.trainable_weights)
        )

        return {"loss": loss}

vae = VAE(encoder, decoder)
vae.compile(optimizer='adam')

vae.fit(x_train, epochs=3, batch_size=128)

# Generate VAE samples
z_sample = tf.random.normal((10, latent_dim))
vae_images = decoder.predict(z_sample)

# ---------------- GAN MODEL ----------------

# Generator
generator = tf.keras.Sequential([
    layers.Input(shape=(100,)),
    layers.Dense(256, activation='relu'),
    layers.Dense(512, activation='relu'),
    layers.Dense(784, activation='sigmoid')
])

# Discriminator
discriminator = tf.keras.Sequential([
    layers.Input(shape=(784,)),
    layers.Dense(256, activation='relu'),
    layers.Dense(1, activation='sigmoid')
])

discriminator.compile(
    optimizer='adam',
    loss='binary_crossentropy'
)

# Combined GAN training
discriminator.trainable = False

gan_input = layers.Input(shape=(100,))
gan_output = discriminator(generator(gan_input))

gan = Model(gan_input, gan_output)
gan.compile(
    optimizer='adam',
    loss='binary_crossentropy'
)

# Train GAN
discriminator.trainable = True

for epoch in range(3):

    for i in range(0, 10000, 128):

        real_images = x_train[i:i+128]
        batch_size = len(real_images)

        noise = tf.random.normal((batch_size, 100))
        fake_images = generator.predict(
            noise, verbose=0
        )

        discriminator.train_on_batch(
            real_images,
            np.ones((batch_size, 1))
        )

        discriminator.train_on_batch(
            fake_images,
            np.zeros((batch_size, 1))
        )

        noise = tf.random.normal((batch_size, 100))

        gan.train_on_batch(
            noise,
            np.ones((batch_size, 1))
        )

    print("GAN Epoch:", epoch + 1)

# Generate GAN samples
noise = tf.random.normal((10, 100))
gan_images = generator.predict(noise)

# Display VAE and GAN results
plt.figure(figsize=(12, 5))

for i in range(10):
    plt.subplot(2, 10, i + 1)
    plt.imshow(vae_images[i].reshape(28, 28), cmap='gray')
    plt.axis('off')

    plt.subplot(2, 10, i + 11)
    plt.imshow(gan_images[i].reshape(28, 28), cmap='gray')
    plt.axis('off')

plt.suptitle("VAE (Top) vs GAN (Bottom)")
plt.show()

print("VAE and GAN Sample Generation Completed")
